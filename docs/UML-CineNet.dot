digraph CineNet {
graph [rankdir=TB, bgcolor="#FFFFFF", nodesep=.40, ranksep=.65, splines=polyline, pad=.23, labelloc=t, labeljust=l, fontname="DejaVu Sans", fontsize=19, label=<CineNet • Diagrama de classes<BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#53657B">Visão geral · operações selecionadas · detalhes em docs/</FONT>>];
node [shape=plain, fontname="DejaVu Sans", fontsize=10, fontcolor="#15243C"];
edge [fontname="DejaVu Sans", fontsize=8, fontcolor="#304664", arrowsize=.72];
subgraph cluster_catalogo {
label="Catálogo e sessões"; color="#CBD4E0"; style=rounded; margin=17;
Cinema [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#174E63" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#174E63"><FONT COLOR="white"><B>Cinema</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ buscarSessao(int): Sessao</TD></TR><TR><TD ALIGN="LEFT">+ cadastrarFilme(Filme): void</TD></TR><TR><TD ALIGN="LEFT">+ cadastrarSala(Sala): void</TD></TR></TABLE>>];
Filme [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#174E63" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#174E63"><FONT COLOR="white"><B>Filme</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ getId(): int</TD></TR><TR><TD ALIGN="LEFT">+ getTitulo(): String</TD></TR></TABLE>>];
Sala [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#174E63" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#174E63"><FONT COLOR="white"><B>Sala</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ getCapacidade(): int</TD></TR><TR><TD ALIGN="LEFT">+ getNumero(): int</TD></TR></TABLE>>];
Sessao [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#174E63" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#174E63"><FONT COLOR="white"><B>Sessao</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ assentoDisponivel(int): boolean</TD></TR><TR><TD ALIGN="LEFT">+ mostraAssentos(): void</TD></TR><TR><TD ALIGN="LEFT">+ ocuparAssento(int): void</TD></TR></TABLE>>];
}
subgraph cluster_bilheteria {
label="Bilheteria e arquivos"; color="#CBD4E0"; style=rounded; margin=17;
Bilheteria [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#294482" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#294482"><FONT COLOR="white"><B>Bilheteria</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ calcularTotalVendas(): double</TD></TR><TR><TD ALIGN="LEFT">+ carregarVendas(Path, List&lt;Sessao&gt;): void</TD></TR><TR><TD ALIGN="LEFT">+ comprarIngresso(String, Sessao, int, String): Venda</TD></TR></TABLE>>];
Venda [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#294482" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#294482"><FONT COLOR="white"><B>Venda</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ getValor(): double</TD></TR><TR><TD ALIGN="LEFT">+ mostraInfo(): void</TD></TR></TABLE>>];
Ingresso [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#294482" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#294482"><FONT COLOR="white" POINT-SIZE="8">«abstrata»</FONT><BR/><FONT COLOR="white"><B>Ingresso</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><I>+ calcularPreco(): double</I></TD></TR></TABLE>>];
IngressoInteira [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#294482" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#294482"><FONT COLOR="white"><B>IngressoInteira</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ calcularPreco(): double</TD></TR></TABLE>>];
IngressoMeia [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#294482" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#294482"><FONT COLOR="white"><B>IngressoMeia</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ calcularPreco(): double</TD></TR></TABLE>>];
AssentoOcupadoException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#294482" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#294482"><FONT COLOR="white"><B>AssentoOcupadoException</B></FONT></TD></TR></TABLE>>];
ArquivoCinema [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#294482" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#294482"><FONT COLOR="white"><B>ArquivoCinema</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ carregarVendas(List&lt;Sessao&gt;): ArrayList&lt;Venda&gt;</TD></TR><TR><TD ALIGN="LEFT">+ salvarVendas(List&lt;Venda&gt;): void</TD></TR></TABLE>>];
ArquivoTexto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#294482" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#294482"><FONT COLOR="white"><B>ArquivoTexto</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><U>+ gravarLinhas(Path, List&lt;String&gt;): void</U></TD></TR><TR><TD ALIGN="LEFT"><U>+ lerLinhas(Path): List&lt;String&gt;</U></TD></TR></TABLE>>];
}
subgraph cluster_atendimento {
label="Atendimento e integração"; color="#CBD4E0"; style=rounded; margin=17;
Main [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#594477" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#594477"><FONT COLOR="white"><B>Main</B></FONT></TD></TR></TABLE>>];
Atendimento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#594477" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#594477"><FONT COLOR="white" POINT-SIZE="8">«interface»</FONT><BR/><FONT COLOR="white"><B>Atendimento</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><I>+ exibirMenu(): void</I></TD></TR><TR><TD ALIGN="LEFT"><I>+ receberOpcao(String, int, int): int</I></TD></TR></TABLE>>];
AtendimentoBase [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#594477" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#594477"><FONT COLOR="white" POINT-SIZE="8">«abstrata»</FONT><BR/><FONT COLOR="white"><B>AtendimentoBase</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ receberOpcao(String, int, int): int</TD></TR></TABLE>>];
MenuCliente [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#594477" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#594477"><FONT COLOR="white"><B>MenuCliente</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ exibirMenu(): void</TD></TR></TABLE>>];
MenuFuncionario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#594477" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#594477"><FONT COLOR="white"><B>MenuFuncionario</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ exibirMenu(): void</TD></TR></TABLE>>];
ControladorAtendimento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#594477" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#594477"><FONT COLOR="white"><B>ControladorAtendimento</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ executar(): void</TD></TR></TABLE>>];
MensagensSistema [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#594477" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#594477"><FONT COLOR="white"><B>MensagensSistema</B></FONT></TD></TR></TABLE>>];
ValidadorEntrada [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#594477" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#594477"><FONT COLOR="white"><B>ValidadorEntrada</B></FONT></TD></TR></TABLE>>];
ArquivoServidor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#594477" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#594477"><FONT COLOR="white"><B>ArquivoServidor</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ carregarDados(Cinema, Bilheteria): void</TD></TR></TABLE>>];
}
Exception [shape=box, style="rounded,filled", fillcolor="#F6F7FA", color="#BCC8D2", label="Exception\n«referência»"];
IngressoInteira -> Ingresso [arrowhead=empty, style=solid, color="#354762"];
IngressoMeia -> Ingresso [arrowhead=empty, style=solid, color="#354762"];
AssentoOcupadoException -> Exception [arrowhead=empty, style=solid, color="#354762"];
AtendimentoBase -> Atendimento [arrowhead=empty, style=dashed, color="#354762"];
MenuCliente -> AtendimentoBase [arrowhead=empty, style=solid, color="#354762"];
MenuFuncionario -> AtendimentoBase [arrowhead=empty, style=solid, color="#354762"];
Cinema -> Filme [arrowhead=vee,  taillabel="1", headlabel="0..*", labeldistance=1.6, color="#3F647D"];
Cinema -> Sala [arrowhead=vee,  taillabel="1", headlabel="0..*", labeldistance=1.6, color="#3F647D"];
Cinema -> Sessao [arrowhead=vee,  taillabel="1", headlabel="0..*", labeldistance=1.6, color="#3F647D"];
Sessao -> Filme [arrowhead=vee,  taillabel="0..*", headlabel="1", labeldistance=1.6, color="#3F647D"];
Sessao -> Sala [arrowhead=vee,  taillabel="0..*", headlabel="1", labeldistance=1.6, color="#3F647D"];
Bilheteria -> Venda [arrowhead=vee,  taillabel="1", headlabel="0..*", labeldistance=1.6, color="#3F647D"];
Venda -> Sessao [arrowhead=vee,  taillabel="0..*", headlabel="1", labeldistance=1.6, color="#3F647D"];
Venda -> Ingresso [arrowhead=vee,  taillabel="", headlabel="1", labeldistance=1.6, color="#3F647D"];
ControladorAtendimento -> Atendimento [arrowhead=vee, xlabel="atendimento", taillabel="", headlabel="1", labeldistance=1.6, color="#3F647D"];
ControladorAtendimento -> Cinema [arrowhead=vee, xlabel="cinema", taillabel="", headlabel="1", labeldistance=1.6, color="#3F647D"];
ControladorAtendimento -> Bilheteria [arrowhead=vee, xlabel="bilheteria", taillabel="", headlabel="1", labeldistance=1.6, color="#3F647D"];
ControladorAtendimento -> ArquivoServidor [arrowhead=vee, xlabel="arquivos", taillabel="", headlabel="1", labeldistance=1.6, color="#3F647D"];
ArquivoServidor -> ArquivoCinema [dir=both, arrowtail=diamond, arrowhead=none, headlabel="3", taillabel="1", color="#355670"];
Main -> ArquivoServidor [arrowhead=open, style=dashed, color="#7B879A", constraint=false];
Main -> ControladorAtendimento [arrowhead=open, style=dashed, color="#7B879A", constraint=false];
AtendimentoBase -> ValidadorEntrada [arrowhead=open, style=dashed, color="#7B879A", constraint=false];
AtendimentoBase -> MensagensSistema [arrowhead=open, style=dashed, color="#7B879A", constraint=false];
Bilheteria -> ArquivoCinema [arrowhead=open, style=dashed, color="#7B879A", constraint=false];
Bilheteria -> AssentoOcupadoException [arrowhead=open, style=dashed, color="#7B879A", constraint=false];
ArquivoCinema -> ArquivoTexto [arrowhead=open, style=dashed, color="#7B879A", constraint=false];
}
