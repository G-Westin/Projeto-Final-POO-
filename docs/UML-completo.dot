ValidadorEntrada [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#594477" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#594477"><FONT COLOR="white"><B>ValidadorEntrada</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">- ValidadorEntrada()</TD></TR><TR><TD ALIGN="LEFT"><U>+ ehNumero(texto: String): boolean</U></TD></TR><TR><TD ALIGN="LEFT"><U>+ opcaoValida(opcao: int, minimo: int, maximo: int): boolean</U></TD></TR><TR><TD ALIGN="LEFT"><U>+ textoValido(texto: String): boolean</U></TD></TR></TABLE>>];
ArquivoServidor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#594477" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#594477"><FONT COLOR="white"><B>ArquivoServidor</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">- arquivoFilmes: ArquivoCinema {readOnly}</TD></TR><TR><TD ALIGN="LEFT">- arquivoSalas: ArquivoCinema {readOnly}</TD></TR><TR><TD ALIGN="LEFT">- arquivoSessoes: ArquivoCinema {readOnly}</TD></TR><TR><TD ALIGN="LEFT">- arquivoVendas: Path {readOnly}</TD></TR><HR/><TR><TD ALIGN="LEFT">+ ArquivoServidor(pasta: Path)</TD></TR><TR><TD ALIGN="LEFT">+ cadastrarFilme(cinema: Cinema, filme: Filme): void</TD></TR><TR><TD ALIGN="LEFT">+ cadastrarSala(cinema: Cinema, sala: Sala): void</TD></TR><TR><TD ALIGN="LEFT">+ cadastrarSessao(cinema: Cinema, sessao: Sessao): void</TD></TR><TR><TD ALIGN="LEFT">+ carregarDados(cinema: Cinema, bilheteria: Bilheteria): void</TD></TR><TR><TD ALIGN="LEFT">+ getArquivoVendas(): Path</TD></TR></TABLE>>];
}
