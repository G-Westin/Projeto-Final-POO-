MenuFuncionario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#594477" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#594477"><FONT COLOR="white"><B>MenuFuncionario</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ MenuFuncionario()</TD></TR><TR><TD ALIGN="LEFT">+ exibirMenu(): void</TD></TR><TR><TD ALIGN="LEFT">+ getTotalOpcoes(): int</TD></TR></TABLE>>];
ControladorAtendimento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#594477" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#594477"><FONT COLOR="white"><B>ControladorAtendimento</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><U>- FORMATO_DATA: DateTimeFormatter {readOnly}</U></TD></TR><TR><TD ALIGN="LEFT">- cinema: Cinema {readOnly}</TD></TR><TR><TD ALIGN="LEFT">- bilheteria: Bilheteria {readOnly}</TD></TR><TR><TD ALIGN="LEFT">- atendimento: Atendimento {readOnly}</TD></TR><TR><TD ALIGN="LEFT">- arquivos: ArquivoServidor {readOnly}</TD></TR><HR/><TR><TD ALIGN="LEFT">+ ControladorAtendimento(cinema: Cinema, bilheteria: Bilheteria, atendimento: Atendimento, arquivos: ArquivoServidor)</TD></TR><TR><TD ALIGN="LEFT">- cadastrarFilme(): void</TD></TR><TR><TD ALIGN="LEFT">- cadastrarSala(): void</TD></TR><TR><TD ALIGN="LEFT">- cadastrarSessao(): void</TD></TR><TR><TD ALIGN="LEFT">- cancelarOperacao(): void</TD></TR><TR><TD ALIGN="LEFT">- comprarIngresso(): void</TD></TR><TR><TD ALIGN="LEFT">- consultarFilmes(): void</TD></TR><TR><TD ALIGN="LEFT">- consultarSessoes(): void</TD></TR><TR><TD ALIGN="LEFT">- consultarVendas(): void</TD></TR><TR><TD ALIGN="LEFT">- encaminharSolicitacao(opcao: int): void</TD></TR><TR><TD ALIGN="LEFT">+ executar(): void</TD></TR></TABLE>>];
