AtendimentoBase [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#594477" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#594477"><FONT COLOR="white" POINT-SIZE="8">«abstrata»</FONT><BR/><FONT COLOR="white"><B>AtendimentoBase</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><U>- input: Scanner {readOnly}</U></TD></TR><HR/><TR><TD ALIGN="LEFT">+ AtendimentoBase()</TD></TR><TR><TD ALIGN="LEFT"><U>+ closeScanner(): void</U></TD></TR><TR><TD ALIGN="LEFT">+ continuarAtendimento(): boolean</TD></TR><TR><TD ALIGN="LEFT"><U>+ escolherPerfil(): int</U></TD></TR><TR><TD ALIGN="LEFT"><I>+ exibirMenu(): void</I></TD></TR><TR><TD ALIGN="LEFT"><I>+ getTotalOpcoes(): int</I></TD></TR><TR><TD ALIGN="LEFT"><U>- lerLinha(mensagem: String): String</U></TD></TR><TR><TD ALIGN="LEFT"><U>+ lerOpcao(mensagem: String, minimo: int, maximo: int): int</U></TD></TR><TR><TD ALIGN="LEFT">+ receberOpcao(mensagem: String, minimo: int, maximo: int): int</TD></TR><TR><TD ALIGN="LEFT">+ receberTexto(mensagem: String): String</TD></TR></TABLE>>];
