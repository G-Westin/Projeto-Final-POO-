digraph CineNet {
graph [rankdir=LR, bgcolor="#FFFFFF", nodesep=.40, ranksep=.65, splines=polyline, pad=.23, labelloc=t, labeljust=l, fontname="DejaVu Sans", fontsize=19, label=<CineNet • Catálogo e sessões<BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#53657B">Detalhe · membros declarados no código</FONT>>];
node [shape=plain, fontname="DejaVu Sans", fontsize=10, fontcolor="#15243C"];
edge [fontname="DejaVu Sans", fontsize=8, fontcolor="#304664", arrowsize=.72];
Cinema [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#174E63" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#174E63"><FONT COLOR="white"><B>Cinema</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">- nome: String {readOnly}</TD></TR><TR><TD ALIGN="LEFT">- filmes: ArrayList&lt;Filme&gt; {readOnly}</TD></TR><TR><TD ALIGN="LEFT">- salas: ArrayList&lt;Sala&gt; {readOnly}</TD></TR><TR><TD ALIGN="LEFT">- sessoes: ArrayList&lt;Sessao&gt; {readOnly}</TD></TR><HR/><TR><TD ALIGN="LEFT">+ Cinema(nome: String)</TD></TR><TR><TD ALIGN="LEFT">+ buscarFilme(id: int): Filme</TD></TR><TR><TD ALIGN="LEFT">+ buscarSala(numero: int): Sala</TD></TR><TR><TD ALIGN="LEFT">+ buscarSessao(id: int): Sessao</TD></TR><TR><TD ALIGN="LEFT">+ cadastrarFilme(filme: Filme): void</TD></TR><TR><TD ALIGN="LEFT">+ cadastrarSala(sala: Sala): void</TD></TR><TR><TD ALIGN="LEFT">+ cadastrarSessao(sessao: Sessao): void</TD></TR><TR><TD ALIGN="LEFT">- gerarProximoId(ultimoId: int): int</TD></TR><TR><TD ALIGN="LEFT">+ getFilmes(): ArrayList&lt;Filme&gt;</TD></TR><TR><TD ALIGN="LEFT">+ getNome(): String</TD></TR><TR><TD ALIGN="LEFT">+ getSalas(): ArrayList&lt;Sala&gt;</TD></TR><TR><TD ALIGN="LEFT">+ getSessoes(): ArrayList&lt;Sessao&gt;</TD></TR><TR><TD ALIGN="LEFT">+ listarFilmes(): void</TD></TR><TR><TD ALIGN="LEFT">+ listarSalas(): void</TD></TR><TR><TD ALIGN="LEFT">+ listarSessoes(): void</TD></TR><TR><TD ALIGN="LEFT">+ proximoIdFilme(): int</TD></TR><TR><TD ALIGN="LEFT">+ proximoIdSessao(): int</TD></TR><TR><TD ALIGN="LEFT">+ validarNovaSala(sala: Sala): void</TD></TR><TR><TD ALIGN="LEFT">+ validarNovaSessao(sessao: Sessao): void</TD></TR><TR><TD ALIGN="LEFT">+ validarNovoFilme(filme: Filme): void</TD></TR></TABLE>>];
Filme [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#174E63" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#174E63"><FONT COLOR="white"><B>Filme</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: int {readOnly}</TD></TR><TR><TD ALIGN="LEFT">- titulo: String {readOnly}</TD></TR><TR><TD ALIGN="LEFT">- genero: String {readOnly}</TD></TR><TR><TD ALIGN="LEFT">- duracao: int {readOnly}</TD></TR><TR><TD ALIGN="LEFT">- classificacao: String {readOnly}</TD></TR><HR/><TR><TD ALIGN="LEFT">+ Filme(id: int, titulo: String, genero: String, duracao: int, classificacao: String)</TD></TR><TR><TD ALIGN="LEFT">+ getClassificacao(): String</TD></TR><TR><TD ALIGN="LEFT">+ getDuracao(): int</TD></TR><TR><TD ALIGN="LEFT">+ getGenero(): String</TD></TR><TR><TD ALIGN="LEFT">+ getId(): int</TD></TR><TR><TD ALIGN="LEFT">+ getTitulo(): String</TD></TR><TR><TD ALIGN="LEFT">+ mostraInfo(): void</TD></TR><TR><TD ALIGN="LEFT"><U>- validarCampo(valor: String, campo: String): String</U></TD></TR></TABLE>>];
Sala [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#174E63" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#174E63"><FONT COLOR="white"><B>Sala</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><U>+ CAPACIDADE_MAXIMA: int {readOnly}</U></TD></TR><TR><TD ALIGN="LEFT">- numero: int {readOnly}</TD></TR><TR><TD ALIGN="LEFT">- capacidade: int {readOnly}</TD></TR><HR/><TR><TD ALIGN="LEFT">+ Sala(numero: int, capacidade: int)</TD></TR><TR><TD ALIGN="LEFT">+ getCapacidade(): int</TD></TR><TR><TD ALIGN="LEFT">+ getNumero(): int</TD></TR></TABLE>>];
Sessao [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#174E63" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#174E63"><FONT COLOR="white"><B>Sessao</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><U>- FORMATO_EXIBICAO: DateTimeFormatter {readOnly}</U></TD></TR><TR><TD ALIGN="LEFT">- id: int {readOnly}</TD></TR><TR><TD ALIGN="LEFT">- filme: Filme {readOnly}</TD></TR><TR><TD ALIGN="LEFT">- sala: Sala {readOnly}</TD></TR><TR><TD ALIGN="LEFT">- horario: LocalDateTime {readOnly}</TD></TR><TR><TD ALIGN="LEFT">- assentos: boolean[] {readOnly}</TD></TR><HR/><TR><TD ALIGN="LEFT">+ Sessao(id: int, filme: Filme, sala: Sala, horario: LocalDateTime)</TD></TR><TR><TD ALIGN="LEFT">+ assentoDisponivel(numero: int): boolean</TD></TR><TR><TD ALIGN="LEFT">+ getFilme(): Filme</TD></TR><TR><TD ALIGN="LEFT">+ getHorario(): LocalDateTime</TD></TR><TR><TD ALIGN="LEFT">+ getId(): int</TD></TR><TR><TD ALIGN="LEFT">+ getSala(): Sala</TD></TR><TR><TD ALIGN="LEFT">- indiceAssento(numero: int): int</TD></TR><TR><TD ALIGN="LEFT">+ mostraAssentos(): void</TD></TR><TR><TD ALIGN="LEFT">+ mostraInfo(): void</TD></TR><TR><TD ALIGN="LEFT">+ ocuparAssento(numero: int): void</TD></TR></TABLE>>];
Cinema -> Filme [arrowhead=vee, xlabel="filmes", taillabel="1", headlabel="0..*", labeldistance=1.6, color="#3F647D"];
Cinema -> Sala [arrowhead=vee, xlabel="salas", taillabel="1", headlabel="0..*", labeldistance=1.6, color="#3F647D"];
Cinema -> Sessao [arrowhead=vee, xlabel="sessoes", taillabel="1", headlabel="0..*", labeldistance=1.6, color="#3F647D"];
Sessao -> Filme [arrowhead=vee, xlabel="filme", taillabel="0..*", headlabel="1", labeldistance=1.6, color="#3F647D"];
Sessao -> Sala [arrowhead=vee, xlabel="sala", taillabel="0..*", headlabel="1", labeldistance=1.6, color="#3F647D"];
}
